# order-fulfillment demo 业务 mock MCP（biz-mcp）
# 零依赖 Python streamableHttp MCP：get_order / get_inventory / create_resolution（L3 校验）
# 部署：kubectl apply -f k8s/biz-mcp.yaml（成员服务的 mcp-configs 指向 biz-mcp:8300）
apiVersion: v1
kind: ConfigMap
metadata:
  name: biz-mcp-script
  namespace: agent-platform
  labels: {app: biz-mcp, demo: order-fulfillment}
data:
  biz_mcp.py: |
{{ indent 4 .Script }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: biz-mcp
  namespace: agent-platform
  labels: {app: biz-mcp, demo: order-fulfillment}
spec:
  replicas: 1
  selector:
    matchLabels: {app: biz-mcp}
  template:
    metadata:
      labels: {app: biz-mcp}
    spec:
      containers:
        - name: biz-mcp
          image: 172.20.0.1:5001/python:3.12-alpine
          command: ["python", "/app/biz_mcp.py"]
          ports: [{containerPort: 8300}]
          volumeMounts:
            - {name: script, mountPath: /app}
          readinessProbe:
            httpGet: {path: /health, port: 8300}
            initialDelaySeconds: 3
            periodSeconds: 5
      volumes:
        - name: script
          configMap: {name: biz-mcp-script}
---
apiVersion: v1
kind: Service
metadata:
  name: biz-mcp
  namespace: agent-platform
  labels: {app: biz-mcp, demo: order-fulfillment}
spec:
  selector: {app: biz-mcp}
  ports: [{port: 8300, targetPort: 8300}]
