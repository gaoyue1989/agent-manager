<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- ========== 自定义转换器 ========== -->
    <conversionRule conversionWord="traceId"
        converterClass="io.agentmanager.framework.service.TraceIdConverter"/>

    <!-- ========== 属性定义 ========== -->
    <property name="LOG_PATH" value="${LOG_PATH:-${user.home}/logs/agent-framework}"/>
    <property name="APP_NAME" value="agent-framework"/>
    <property name="MAX_FILE_SIZE" value="100MB"/>
    <property name="MAX_HISTORY" value="30"/>
    <property name="TOTAL_SIZE_CAP" value="5GB"/>

    <!-- ========== 日志格式 ========== -->
    <!-- 控制台：彩色 + 关键上下文 -->
    <property name="CONSOLE_PATTERN"
        value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%cyan(%traceId)] [%thread] %logger{36} - %msg%n"/>
    <!-- 文件：纯文本 + 完整上下文（含 MDC） -->
    <property name="FILE_PATTERN"
        value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%traceId] [%X{requestId:-}] [%X{sessionId:-}] [%X{userId:-}] [%thread] %logger{50} - %msg%n"/>

    <!-- ========== 控制台 Appender ========== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ========== 全量日志文件 Appender ========== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ========== ERROR 级别独立日志文件 ========== -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ========== Spring Profile 配置 ========== -->

    <!-- 开发环境：控制台为主，DEBUG 级别 -->
    <springProfile name="dev | default">
        <logger name="io.agentmanager.framework" level="DEBUG"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

    <!-- 测试环境：控制台 + 文件 -->
    <springProfile name="test">
        <logger name="io.agentmanager.framework" level="DEBUG"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

    <!-- 生产环境：仅文件，INFO 级别 -->
    <springProfile name="prod">
        <logger name="io.agentmanager.framework" level="INFO"/>
        <root level="WARN">
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

    <!-- ========== 第三方框架日志降噪 ========== -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="io.agentscope" level="INFO"/>
    <!-- 临时：排查 400 unexpected content after document 时打印请求体 JSON，问题定位后恢复 INFO -->
    <logger name="io.agentscope.extensions.model.openai.OpenAIClient" level="DEBUG"/>
    <logger name="io.modelcontextprotocol" level="WARN"/>
    <logger name="io.opentelemetry" level="WARN"/>
    <logger name="org.apache.http" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="reactor.netty" level="WARN"/>
</configuration>
