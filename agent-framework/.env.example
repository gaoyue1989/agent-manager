# ==============================================================================
# Agent Framework 环境变量完整示例（v2.1.0 / Java 21）
# 与 agent-framework/src/main/resources/application.yml 及各 @ConfigurationProperties 同步。
# 使用方式：复制为 .env，按需取消注释并填写对应值；注释行中的值即为框架默认生效值。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM 系统模型（必填三项：LLM_API_KEY / LLM_MODEL_ID / LLM_BASE_URL）
# ------------------------------------------------------------------------------
# LLM API 密钥（必填）
LLM_API_KEY=your_api_key_here
# 默认系统模型 ID（必填；同时承担会话标题生成、记忆整合与上下文压缩任务）
LLM_MODEL_ID=your_model_id_here
# OpenAI 兼容接口地址（必填）
LLM_BASE_URL=https://api.example.com/v1
# 推理引擎方言：openai | vllm | sglang | glm | deepseek（决定思考/推理参数下发位置）
LLM_PROVIDER=openai
# 生成温度（默认 0.3）
LLM_TEMPERATURE=0.3
# 单次最大输出 token 数（默认 16384）
LLM_MAX_TOKENS=16384
# LLM 单次 API 调用超时时间（秒，默认 120）
# LLM_TIMEOUT=120
# 深度思考开关：false 时对 Qwen3/vLLM 注入 enable_thinking=false，避免混入 <think> 片段
# LLM_ENABLE_THINKING=false
# 模型上下文窗口大小（tokens；<=0 表示不显式传给模型）
# LLM_CONTEXT_LENGTH=0
# 推理强度（如 minimal / low / medium / high；空表示不下发，具体枚举依上游模型而定）
# LLM_REASONING_EFFORT=
# 频率惩罚（[-2.0, 2.0]；空表示不下发）
# LLM_FREQUENCY_PENALTY=
# 部署级备用模型 ID（引用 model_config 表托管模型 id）：主模型重试耗尽后自动切换；DB 侧 is_fallback 优先
# LLM_FALLBACK_MODEL_ID=

# ------------------------------------------------------------------------------
# 2. 服务监听、目录路径与日志
# ------------------------------------------------------------------------------
# 服务监听地址（默认 0.0.0.0）
SERVER_HOST=0.0.0.0
# 主业务 HTTP 端口（默认 8100）
SERVER_PORT=8100
# Actuator / Prometheus 监控管理端口（独立于业务端口，默认 9091，暴露 health/metrics/prometheus）
# MANAGEMENT_SERVER_PORT=9091
# OAF 配置包目录（只读，含 AGENTS.md、skills/、mcp-configs/、plugins/；默认 /config）
AGENT_CONFIG_DIR=/config
# 可写工作区目录（空则回落 AGENT_CONFIG_DIR；K8s/平台部署必须显式设为可写目录如 /workspace）
# AGENT_WORKSPACE_DIR=/workspace
# Java SPI 工具插件目录（未设时默认 {AGENT_CONFIG_DIR}/plugins，启动期扫描 *.jar）
# AGENT_PLUGINS_DIR=/config/plugins
# 文件日志输出目录（默认 ${user.home}/logs/agent-framework）
# LOG_PATH=/applog
# 框架包 io.agentmanager.framework 日志级别（DEBUG / INFO / WARN / ERROR，默认 INFO）
# APP_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. MySQL Checkpoint 持久化（agent_state / agent_fs / Flyway 自动迁移）
# ------------------------------------------------------------------------------
# MySQL JDBC 连接串（账号需具备建表与 Flyway 迁移权限）
CHECKPOINT_JDBC_URL=jdbc:mysql://127.0.0.1:3307/agent_manager_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# MySQL 用户名
CHECKPOINT_USERNAME=agent_manager
# MySQL 密码
CHECKPOINT_PASSWORD=Agent@Manager2026
# agent_state 所在库名（留空时自动从 CHECKPOINT_JDBC_URL 解析，保证与 agent_fs 同库）
# CHECKPOINT_DB_NAME=

# ------------------------------------------------------------------------------
# 4. Redis（SSE 事件流 session_event、沙箱执行守卫、分布式锁与协议事件总线）
# ------------------------------------------------------------------------------
# Redis 连接地址（集群部署必配！默认 localhost 会导致事件不落库、断线回放失效）
AGENT_REDIS_URL=redis://127.0.0.1:6379
# 连接模式：standalone | cluster（暂不支持 sentinel；cluster 模式下 AGENT_REDIS_URL 兼作单种子节点）
# AGENT_REDIS_MODE=standalone
# cluster 模式种子节点列表（逗号分隔，如 redis://n1:6379,redis://n2:6379；空则回落 AGENT_REDIS_URL）
# AGENT_REDIS_CLUSTER_NODES=
# Redis Key 统一前缀（多 Agent 共用同一 Redis 时的隔离前缀；不可含 { }；首次部署定好勿随意改）
# AGENT_REDIS_PREFIX=
# 单条 Redis 命令超时（毫秒，默认 2000，防止阻塞 Tomcat 线程）
# AGENT_REDIS_COMMAND_TIMEOUT_MS=2000
# Redis 建连超时（毫秒，默认 2000）
# AGENT_REDIS_CONNECT_TIMEOUT_MS=2000
# 单会话 Redis Stream 最大事件条数（内存兜底上限，默认 250000）
# AGENT_REDIS_MAX_LEN_PER_STREAM=250000

# ------------------------------------------------------------------------------
# 5. OpenSandbox 沙箱、生命周期与技能同步（含无镜像依赖降级）
# ------------------------------------------------------------------------------
# 沙箱模式总开关（三层裁决：此 env 显式存在 > AGENTS.md config.sandbox.enabled > 默认 false）
# SANDBOX_ENABLED=false
# OpenSandbox Server 地址（host:port 或 http://host:port）
# OPENSANDBOX_SERVER_URL=192.168.31.155:8090
# OpenSandbox Server API 密钥（启用沙箱时按服务端配置填写）
# OPENSANDBOX_API_KEY=
# 沙箱容器镜像（支持上游标准镜像或内置 skills-syncd 的定制镜像）
# SANDBOX_IMAGE=opensandbox/code-interpreter:v1.1.0
# 沙箱生命周期 TTL（分钟，默认 30；随每轮对话与在途续期动态刷新）
# SANDBOX_TIMEOUT_MINUTES=30
# 建箱与管理面单次 HTTP 请求超时（秒，默认 30；<=0 走 SDK 默认）
# SANDBOX_REQUEST_TIMEOUT_SECONDS=30
# 沙箱内存上限（MiB，默认 1024）
# SANDBOX_MEMORY_MB=1024
# 沙箱 CPU 核数（默认 1）
# SANDBOX_CPU_COUNT=1
# 沙箱容器启动入口命令（逗号分隔，默认 /opt/code-interpreter/code-interpreter.sh）
# SANDBOX_ENTRYPOINT=/opt/code-interpreter/code-interpreter.sh
# execd 命令 SSE 尾窗保持时间（默认 100ms，显著低于上游 1s 默认值以降低命令时延）
# SANDBOX_EXECD_GRACE_SHUTDOWN=100ms
# 工作区基础文件投影开关（AGENTS.md/skills/subagents/knowledge；默认 true）
# SANDBOX_PROJECTION_ENABLED=true
# 沙箱获取并发守卫开关（Redis SET NX 串行化，默认 true；启用 lifecycle 时必须开启）
# SANDBOX_GUARD_ENABLED=true
# 并发守卫锁租约时长（秒，崩溃自愈，默认 900）
# SANDBOX_GUARD_LEASE_SECONDS=900
# L4 用户技能物化 revision 门控（KV 未变跳过全量物化，默认 true）
# SANDBOX_SKILL_REVISION_GATE=true
# 沙箱回写快照差分（仅读取 size 变更文件，默认 true）
# SANDBOX_SYNC_SNAPSHOT_DIFF=true
# 回写跳过与包内基线一致的技能文件（防止将包技能复制进用户 KV，默认 true）
# SANDBOX_SYNC_SKIP_PACKAGE_BASELINE=true
# 每会话独立 Agent/沙箱代理隔离（消除同用户并行会话互踩，默认 true）
# SANDBOX_SESSION_AGENT_ISOLATION=true
# 会话级 Agent 实例缓存上限（默认 500）
# SANDBOX_SESSION_AGENT_CACHE_MAX=500
# 会话级 Agent 实例空闲过期时间（分钟，默认 30）
# SANDBOX_SESSION_AGENT_CACHE_TTL_MINUTES=30

# --- 5.1 沙箱技能同步（skills-syncd 软链农场 + 无镜像依赖 Push-to-Store 降级）---
# 服务端技能 bundle 磁盘缓存目录（空则自动落 {workspaceBase}/tmp/skills-bundle-cache）
# SKILLSYNC_BUNDLE_CACHE_DIR=
# 沙箱内共享技能库总闸（默认 /skills-store，与 skills-syncd 对齐；填 off 彻底关闭包技能投放）
# SANDBOX_SKILLS_SHARED_STORE=/skills-store
# 无镜像依赖降级模式：push（默认，缺失 /skills-store 或断网时由服务端流式推入独立目录）| off（关闭降级）
# SANDBOX_SKILLS_FALLBACK_MODE=push
# 降级推送在沙箱内的独立存放目录（默认 /tmp/.skills-store，与 /skills-store 零冲突且兼容非 root）
# SANDBOX_SKILLS_FALLBACK_STORE_DIR=/tmp/.skills-store
# 降级单次推送压缩包大小上限（字节，默认 67108864 = 64 MiB；<=0 不限）
# SANDBOX_SKILLS_FALLBACK_MAX_BYTES=67108864
# 单副本并发降级推送信号量上限（默认 4，防全池降级打爆服务端）
# SANDBOX_SKILLS_FALLBACK_MAX_CONCURRENCY=4
# 获取降级推送并发许可的超时（毫秒，默认 5000；超时 fail-open）
# SANDBOX_SKILLS_FALLBACK_ACQUIRE_TIMEOUT_MS=5000
# 沙箱内 /skills-store 版本不匹配时是否允许走 push 降级（默认 true，吸收滚发窗口漂移）
# SANDBOX_SKILLS_FALLBACK_ON_VERSION_MISMATCH=true

# --- 5.2 沙箱生命周期管理（配额 / 绑定 / 池化 / 续期）---
# 沙箱生命周期总开关（默认 true；false 一键回退基线；开启时要求 SANDBOX_GUARD_ENABLED=true）
# SANDBOX_LIFECYCLE_ENABLED=true
# OpenSandbox 服务端暖池名（空表示不用池，直建沙箱）
# SANDBOX_POOL_REF=
# 单用户沙箱配额（0 表示不限；满载且全忙返回 409 / user_quota_exhausted）
# SANDBOX_USER_QUOTA=5
# 在途续期守护线程轮询间隔（秒，默认 60；需小于 TTL*60/2）
# SANDBOX_RENEW_INTERVAL_SECONDS=60
# HITL 确认挂起期间的沙箱保留窗（分钟，默认 20；窗口内持续续期且免于 LRU 回收）
# SANDBOX_CONFIRM_HOLD_MINUTES=20
# 建箱瞬时失败（超时/连接/502）最大重试次数（默认 2；1 表示不重试）
# SANDBOX_CREATE_MAX_ATTEMPTS=2
# 建箱重试初始指数退避毫秒数（默认 1000）
# SANDBOX_CREATE_RETRY_BACKOFF_MS=1000
# 仅 E2E 测试使用的 /debug/sandbox-cleanup 钩子开关（生产务必保持 false）
# SANDBOX_LIFECYCLE_E2E_HOOKS=false
# 本服务 K8s 名称（写入沙箱 metadata.service 供控制台按服务过滤；空则从 HOST_NAME 推导）
# AGENT_SERVICE_K8S_NAME=

# --- 5.3 沙箱高级调优开关（直读环境变量，默认无需修改）---
# 是否将 ls/cat/glob/test 等简单命令翻译为 execd 文件 API 执行（默认 true）
# SANDBOX_EXEC_TRANSLATE=true
# 是否输出沙箱命令执行详细追踪日志（默认 false）
# SANDBOX_EXEC_TRACE=false
# 沙箱数据面连续不可达判定失败的阈值次数（默认 3）
# SANDBOX_EXEC_DATAPLANE_FAIL_LIMIT=3
# 复用沙箱前是否以 execd ping 探活（默认 true）
# SANDBOX_PROBE_EXECD_PING=true
# 记忆混合读穿开关（默认 false；true 跳过启动期全量记忆注入，按需懒注入；灰度须全副本同步切）
# SANDBOX_RUNTIME_READ_THROUGH=false
# turn 收尾是否补投 scoped .skills-cache（默认 true）
# SANDBOX_SKILL_CACHE_STOP_BACKFILL=true

# ------------------------------------------------------------------------------
# 6. 文件上传、交付下载与对象存储
# ------------------------------------------------------------------------------
# 是否启用用户文件上传（默认 true）
# FILE_UPLOAD_ENABLED=true
# 单文件上传大小上限（MB，同时绑定 Spring multipart 上限，默认 20）
# FILE_UPLOAD_MAX_MB=20
# 单会话待注入沙箱的 pending 文件数软上限（默认 20）
# FILE_UPLOAD_MAX_PENDING=20
# 允许上传的 MIME 类型白名单（逗号分隔，支持 * 通配）
# FILE_UPLOAD_ALLOWED_MIME=image/*,text/plain,text/markdown,text/csv,text/html,multipart/related,application/x-mimearchive,application/pdf,application/vnd.openxmlformats-officedocument.*,application/vnd.ms-*,application/msword,application/zip,application/x-zip-compressed
# 单张图片上传上限（MB，默认 5）
# FILE_IMAGE_MAX_MB=5
# 单次对话请求内联图片总大小上限（MB，默认 15）
# FILE_IMAGE_INLINE_TOTAL_MB=15
# present_file 工具交付产物大小上限（MB，默认 50；须大于 FILE_UPLOAD_MAX_MB）
# FILE_PRESENT_MAX_MB=50
# 是否启用文件下载/预览接口（默认 true）
# FILE_DOWNLOAD_ENABLED=true
# 上传与产物文件保留天数（过期由定时清理任务回收，默认 7）
# FILE_RETENTION_DAYS=7
# present_url 外部交付物代理下载的 URL 前缀白名单（逗号分隔；空表示禁用，防 SSRF）
# FILE_EXTERNAL_URL_PREFIXES=
# 文件存储后端类型：local | s3（默认 local）
# FILE_STORAGE_TYPE=local
# local 后端落盘目录（默认 /data/files）
# FILE_STORAGE_LOCAL_DIR=/data/files
# S3 兼容存储端点（storage-type=s3 时必填）
# FILE_STORAGE_S3_ENDPOINT=
# S3 Access Key（storage-type=s3 时必填）
# FILE_STORAGE_S3_ACCESS_KEY=
# S3 Secret Key（storage-type=s3 时必填）
# FILE_STORAGE_S3_SECRET_KEY=
# S3 存储桶名（默认 agent-files）
# FILE_STORAGE_S3_BUCKET=agent-files
# S3 流式落盘临时 spool 目录（空则回落 {workspaceBase}/tmp/file-transfer）
# FILE_SPOOL_DIR=

# ------------------------------------------------------------------------------
# 7. Harness 运行时参数（推理轮次、HTTP 超时、记忆、压缩与数据库连接池）
# ------------------------------------------------------------------------------
# ReAct 推理最大迭代轮次（默认 20；复杂长任务可适当调大）
# AGENT_REACT_MAX_ITERS=20
# LLM HTTP 建连超时（秒，默认 30）
# AGENT_HTTP_CONNECT_TIMEOUT_SECONDS=30
# LLM HTTP 读超时（秒，默认 180）
# AGENT_HTTP_READ_TIMEOUT_SECONDS=180
# LLM HTTP 写超时（秒，默认 30）
# AGENT_HTTP_WRITE_TIMEOUT_SECONDS=30
# 记忆功能总开关（false 时不注册 memory_* 工具、不执行 flush/整合、沙箱不注入/回写记忆，默认 true）
# AGENT_MEMORY_ENABLED=true
# 记忆刷写最小节流间隔（分钟，默认 10）
# AGENT_MEMORY_FLUSH_THROTTLE_MINUTES=10
# 单次记忆整合处理的最大 token 数（默认 8000）
# AGENT_MEMORY_CONSOLIDATION_MAX_TOKENS=8000
# 两次记忆整合的最小时间间隔（分钟，默认 60）
# AGENT_MEMORY_CONSOLIDATION_MIN_GAP_MINUTES=60
# 上下文压缩触发消息条数（与 token 阈值任一命中即压缩，默认 30）
# AGENT_COMPACTION_TRIGGER_MESSAGES=30
# 上下文压缩触发 token 阈值（>0 固定阈值；0 表示按模型窗口减 reserved 动态计算，默认 80000）
# AGENT_COMPACTION_TRIGGER_TOKENS=80000
# 动态压缩模式预留给摘要生成与输出的 token 窗口（默认 20000）
# AGENT_COMPACTION_RESERVED_TOKENS=20000
# 压缩后保留的最近消息条数（默认 10）
# AGENT_COMPACTION_KEEP_MESSAGES=10
# 压缩前是否先刷写记忆（默认 true）
# AGENT_COMPACTION_FLUSH_BEFORE_COMPACT=true
# 压缩前是否先将大工具结果卸载落盘（默认 true）
# AGENT_COMPACTION_OFFLOAD_BEFORE_COMPACT=true
# HikariCP 数据库连接池最大连接数（默认 10）
# AGENT_DB_POOL_MAX_SIZE=10
# HikariCP 最小空闲连接数（默认 2）
# AGENT_DB_POOL_MIN_IDLE=2
# HikariCP 获取连接超时（毫秒，默认 30000）
# AGENT_DB_POOL_CONNECTION_TIMEOUT_MS=30000
# HikariCP 空闲连接回收时间（毫秒，默认 600000）
# AGENT_DB_POOL_IDLE_TIMEOUT_MS=600000
# HikariCP 连接最大生命周期（毫秒，默认 1800000）
# AGENT_DB_POOL_MAX_LIFETIME_MS=1800000

# ------------------------------------------------------------------------------
# 8. OpenViking 外部记忆供给（可选；默认 local 使用内置文件记忆）
# ------------------------------------------------------------------------------
# 记忆供给模式：local（内置文件记忆，默认）| openviking（接入外部 OpenViking 上下文库）
# AGENT_MEMORY_PROVIDER=local
# OpenViking 服务地址（memory-provider=openviking 时必填）
# OPENVIKING_URL=http://openviking-svc.agent-platform.svc.cluster.local:1933
# OpenViking 租户账号名（通常为本服务 K8s 名）
# OPENVIKING_ACCOUNT=
# OpenViking 账户级 ADMIN Key（敏感凭据）
# OVK_ADMIN_KEY=
# 派生每用户密钥的随机种子（敏感凭据）
# OVK_USER_SEED=
# 是否启用会话归档与自动提取记忆（与逐轮 remember 互斥，默认 false）
# OVK_SESSION_COMMIT=false
# 是否注入服务级共享上下文 MCP 工具（find/search/rule_search，默认 false）
# OVK_MCP_SHARED_CONTEXT=false
# 首推理检索超时（毫秒，超时降级无记忆不阻塞对话，默认 2000）
# OVK_SEARCH_TIMEOUT_MS=2000
# 同用户多轮对话的记忆检索缓存时长（秒，默认 300）
# OVK_INJECT_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 9. 历史归档、单轮停止、会话上下文注入与 SSE 可靠传输
# ------------------------------------------------------------------------------
# 会话消息轨 write-through 归档开关（压缩后历史仍完整可查，默认 true）
# AGENT_HISTORY_ARCHIVE_ENABLED=true
# /history 接口单条工具输出截断上限字符数（<=0 不截断，默认 8000）
# AGENT_HISTORY_TOOL_OUTPUT_MAX_CHARS=8000
# 单轮协作式停止开关（POST /threads/{sid}/stop，默认 true）
# AGENT_TURN_STOP_ENABLED=true
# 属主副本轮询 turn_stop 表的周期（毫秒，下限 100，默认 1000）
# AGENT_TURN_STOP_POLL_MS=1000
# 停止后等待终态的告警阈值（毫秒，超时打 WARN，默认 15000）
# AGENT_TURN_STOP_GRACE_MS=15000
# 会话上下文注入（POST /threads/{sid}/context）单会话合计字符上限（超限 413，默认 30000）
# AGENT_SESSION_CONTEXT_MAX_TOTAL_CHARS=30000
# SSE 心跳间隔（秒，防 Nginx/CDN 读超时断连，默认 20）
# AGENT_SSE_HEARTBEAT_SECONDS=20
# 无订阅者的本地 SSE Sink 回收时间（分钟，默认 5）
# AGENT_SSE_SINKS_EVICTION_MINUTES=5
# 单个 SSE Sink 缓冲事件条数（默认 256）
# AGENT_SSE_SINKS_BUFFER_SIZE=256
# 跨副本观察者路径轮询 Redis Stream 间隔（毫秒，默认 300）
# AGENT_SSE_TAIL_POLL_MS=300

# ------------------------------------------------------------------------------
# 10. 定时数据清理（SessionCleanupService）
# ------------------------------------------------------------------------------
# HITL confirm_context 有效时长（分钟，默认 30）
# AGENT_CLEANUP_CONFIRM_TTL_MINUTES=30
# turn_lease 并发互斥租约时长（秒，默认 60）
# AGENT_CLEANUP_TURN_LEASE_TTL_SECONDS=60
# turn_lease 自动续租间隔（秒，默认 20）
# AGENT_CLEANUP_TURN_LEASE_RENEW_SECONDS=20
# tool_audit_log 工具审计日志保留天数（默认 30）
# AGENT_CLEANUP_AUDIT_RETENTION_DAYS=30
# agent_state / agent_fs 会话数据保留天数（默认 7）
# AGENT_CLEANUP_SESSION_RETENTION_DAYS=7
# 宿主 .skills-cache 过期 scope 目录定时 GC 开关（默认 true）
# AGENT_CLEANUP_SKILL_CACHE_GC_ENABLED=true
# 宿主 .skills-cache 目录按龄保留天数（默认 2）
# AGENT_CLEANUP_SKILL_CACHE_RETENTION_DAYS=2
# 宿主 .skills-cache 总容量上限（MB，超限按最旧 mtime 淘汰，<=0 关闭，默认 5120）
# AGENT_CLEANUP_SKILL_CACHE_MAX_TOTAL_MB=5120
# 已过期沙箱绑定行（sandbox_binding）保留天数（默认 7）
# AGENT_CLEANUP_SANDBOX_BINDING_RETENTION_DAYS=7

# ------------------------------------------------------------------------------
# 11. AG-UI 协议输出面（默认关闭，开启暴露 /agui/runs 与 /agui/threads/{id}/events）
# ------------------------------------------------------------------------------
# AG-UI 协议总开关（默认 false）
# AGENT_AGUI_ENABLED=false
# RUN_FINISHED 帧是否携带 token 用量统计（默认 true）
# AGENT_AGUI_EMIT_TOKEN_USAGE=true
# TOOL_CALL 帧是否流式下发工具参数增量（默认 true）
# AGENT_AGUI_EMIT_TOOL_CALL_ARGS=true
# 是否下发 THINKING 深度思考增量（默认 true）
# AGENT_AGUI_ENABLE_REASONING=true
# 子 Agent 事件是否按 native 词表透出（默认 false）
# AGENT_AGUI_EMIT_SUBAGENT_EVENTS_AS_NATIVE=false

# ------------------------------------------------------------------------------
# 12. 浏览器人工接管（默认关闭，需配合浏览器沙箱镜像使用）
# ------------------------------------------------------------------------------
# 浏览器人工接管总开关（默认 false；关闭时端点 404、无工具注册）
# AGENT_BROWSER_ENABLED=false
# 人工接管控制权锁 TTL（分钟，默认 60）
# AGENT_BROWSER_TAKEOVER_TTL_MINUTES=60
# 沙箱内 noVNC / websockify 监听端口（默认 6080）
# AGENT_BROWSER_VIEW_PORT=6080
# 沙箱内 WebSocket 代理路径（默认 /websockify）
# AGENT_BROWSER_VIEW_PATH=/websockify
# 实时画面一次性认证 ticket 有效时长（秒，默认 60）
# AGENT_BROWSER_VNC_TICKET_TTL_SECONDS=60
# 允许建立实时画面 WebSocket 连接的 Origin 白名单（逗号分隔，空则仅允许同源）
# AGENT_BROWSER_ALLOWED_ORIGIN_PATTERNS=

# ------------------------------------------------------------------------------
# 13. Agent Protocol（远程子 Agent 协同，默认关闭）与 A2A 幂等 Job（默认关闭）
# ------------------------------------------------------------------------------
# Agent Protocol 服务端总开关（默认 false；开启时 AGENT_PROTOCOL_AUTH_TOKEN 必填）
# AGENT_PROTOCOL_ENABLED=false
# /tasks* 服务间认证令牌（Header: X-Agent-Protocol-Token；敏感凭据）
# AGENT_PROTOCOL_AUTH_TOKEN=
# 本地 FS TaskStore 退化路径（仅无 agent_fs 时使用；禁止指向只读的 /config）
# AGENT_PROTOCOL_TASK_STORE=
# 协议任务记录保留天数（默认 7）
# AGENT_PROTOCOL_TASK_RETENTION_DAYS=7
# 协议事件总线实现：redis（默认，跨副本可重放，异常自动降级 memory）| memory
# AGENT_PROTOCOL_EVENT_BUS=redis
# SDK 侧协议 HITL 确认续跑开关（默认 true，关闭会导致远程确认中断）
# AGENT_PROTOCOL_HITL_ENABLED=true
# SDK 侧 /tasks/{id}/events SSE 流开关（默认 true）
# AGENT_PROTOCOL_STREAMING_ENABLED=true
# Lead 端远程确认挂起记录 TTL（小时，默认 24）
# AGENT_REMOTE_CONFIRM_TTL_HOURS=24
# Lead 端轮询远程任务状态间隔（秒，默认 5）
# AGENT_REMOTE_POLL_SECONDS=5
# Lead→Member 请求注入的自定义 Header JSON（如 {"X-Agent-Protocol-Token":"..."}；敏感凭据）
# AGENT_REMOTE_HEADERS_JSON=
# 远程 spawn 是否强制同步等待子任务完成（默认 true）
# AGENT_REMOTE_SPAWN_SYNC_WAIT=true
# 远程 spawn 同步等待超时上限（秒，默认 120）
# AGENT_REMOTE_SPAWN_SYNC_WAIT_SECONDS=120

# A2A 幂等 Job 入口总开关（/a2a/jobs，默认 false；开启时 TOKEN 必填且强依赖 Redis）
# AGENT_A2A_JOB_ENABLED=false
# /a2a/jobs 入口认证令牌（Header: Agent-A2A-Job-Token；敏感凭据，与协议 token 独立）
# AGENT_A2A_JOB_TOKEN=
# 同步发送等待超时（秒，默认 300）
# AGENT_A2A_JOB_SEND_TIMEOUT_SECONDS=300
# 完成态幂等记录保留时长（小时，默认 24）
# AGENT_A2A_JOB_RETENTION_HOURS=24
# 单副本最大并发 Job 数（防 loopback 自环占满线程池，默认 32）
# AGENT_A2A_JOB_MAX_CONCURRENT=32

# ------------------------------------------------------------------------------
# 14. OpenTelemetry 链路追踪（默认关闭）
# ------------------------------------------------------------------------------
# OTLP Collector 接收地址（Docker 镜像检测到非空即自动注入 -javaagent）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTLP 上报自定义请求头（如 Authorization=Bearer xxx）
# OTEL_EXPORTER_OTLP_HEADERS=
# 链路追踪中上报的服务名（默认 agent-framework）
# OTEL_SERVICE_NAME=agent-framework
# 采样策略（默认 always_on）
# OTEL_TRACES_SAMPLER=always_on
# 自研 OtelConfig 导出开关（Docker 使用 Java Agent 时保持 unset；不要设为 none 否则会关闭 Agent 导出）
# OTEL_TRACES_EXPORTER=none
