# LLM 配置 (必填)
LLM_API_KEY=your_api_key_here
LLM_MODEL_ID=your_model_id_here
LLM_BASE_URL=https://api.example.com/v1
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
# 模型上下文窗口大小 (可选, tokens, 不配或 <=0 则不传给模型)
# LLM_CONTEXT_LENGTH=131072
# 部署级备用模型 (可选)：引用 model_config 托管模型 id，主模型重试耗尽(429/5xx/超时/网络)后自动切换
# DB 中 PUT /models/{id}/fallback 的配置优先；本项作为未配置时的回退（debug 页 Models 可设置）
# LLM_FALLBACK_MODEL_ID=backup-model-id

# 配置目录路径
AGENT_CONFIG_DIR=/config

# 服务端口
SERVER_PORT=8100
SERVER_HOST=0.0.0.0

# MCP（可选）
# MCP_FILESYSTEM_URL=http://localhost:8811/sse

# MySQL Checkpoint 持久化 (可选)
CHECKPOINT_MYSQL_DSN=mysql+asyncmy://agent_manager:Agent%40Manager2026@127.0.0.1:3307/agent_manager_test
# agent_state 表所在数据库名 (可选, 默认自动从 CHECKPOINT_JDBC_URL 解析)
# CHECKPOINT_DB_NAME=agent_manager_test

# Redis（session_event 事件流存储；集群与前缀设计见 docs/redis-cluster-prefix-design.md）
# AGENT_REDIS_URL=redis://127.0.0.1:6379
# 连接模式 standalone | cluster（sentinel 暂不支持）；cluster 时 AGENT_REDIS_URL 兼任单种子
# AGENT_REDIS_MODE=standalone
# cluster 模式种子节点（逗号分隔，如 redis://n1:6379,redis://n2:6379）；空 = 回落 AGENT_REDIS_URL
# AGENT_REDIS_CLUSTER_NODES=
# key 统一前缀（多 Agent 共用 Redis 的隔离切分）；空 = 不加前缀；不能含 { }；改前缀旧 key 靠 TTL 消亡
# AGENT_REDIS_PREFIX=

# OpenSandbox 沙箱 (可选, SANDBOX_ENABLED=true 启用)
# SANDBOX_ENABLED=false
# SANDBOX_IMAGE=opensandbox/code-interpreter:v1.1.0
# SANDBOX_TIMEOUT_MINUTES=60
# SANDBOX_MEMORY_MB=1024
# SANDBOX_CPU_COUNT=1
# SANDBOX_ENTRYPOINT=/opt/code-interpreter/code-interpreter.sh
# SANDBOX_EXECD_GRACE_SHUTDOWN=100ms
# OPENSANDBOX_SERVER_URL=192.168.31.155:8090
# OPENSANDBOX_API_KEY=your_api_key_here

# 沙箱池化 (可选, SANDBOX_POOL_ENABLED=true 启用; 见 agent-framework/docs/sandbox-pool-design.md)
# 池做在 OpenSandboxClient 契约层: Redis 单 ledger 共享池(集群级容量上限, 多副本共享),
# session 级借出/归还——失活 10min 归还重建、预热免冷启动; 默认 false = 现状(容器按会话建、60min 被 Server GC)
# SANDBOX_POOL_ENABLED=false
# 预热下限(集群级水位, 多副本经 Lua cap 合力补齐不超额)
# SANDBOX_POOL_MIN_IDLE=2
# 集群级总上限: |idle|+|busy|+|creating| <= maxSize (与 OpenSandbox Server 容量对齐, 与副本数解耦)
# SANDBOX_POOL_MAX_SIZE=8
# 借出等待上限秒(超时报"沙箱繁忙"; 须 < 守卫租约 900s 与 a2a-job send-timeout 300s)
# SANDBOX_POOL_MAX_WAIT_SECONDS=120
# busy 容器空闲租约 TTL 秒 = 会话失活判定阈值; 硬不变量: >= AGENT_CONFIRM_DEADLINE_MINUTES (D15, 违反拒绝启动)
# SANDBOX_POOL_IDLE_RETURN_SECONDS=600
# 回收/补位/保活扫描周期秒
# SANDBOX_POOL_SCAN_INTERVAL_SECONDS=60
# 补位创建并发上限(集群级, 经 Lua cap 裁决)
# SANDBOX_POOL_REBUILD_CONCURRENCY=2

# HITL 确认硬截止 (sandbox-pool-design D16; 独立于池化生效)
# ASKING 挂起超过该分钟数后: 迟到确认 410 confirm_expired + 自动按拒绝收尾; 迟到消息懒收尾放行
# 确认卡从「无限期可确认」变为 10min 硬截止(超时=作废), 前端展示倒计时/过期态
# AGENT_CONFIRM_DEADLINE_MINUTES=10
# confirm_context 兜底行寿命(分钟)——按 D16 决议默认 30→10(行删除时确认必已超截止; state 仍是无 TTL 权威源, 恢复能力不变)
# AGENT_CLEANUP_CONFIRM_TTL_MINUTES=10

# Harness 运行时参数 (可选, 以下均为默认值, 见 AgentManagerProperties.HarnessConfig)
# ReAct 推理最大轮次 (SDK 默认 10, 长流程需放宽)
# AGENT_REACT_MAX_ITERS=20
# LLM API HTTP 超时 (秒)
# AGENT_HTTP_CONNECT_TIMEOUT_SECONDS=30
# AGENT_HTTP_READ_TIMEOUT_SECONDS=180
# AGENT_HTTP_WRITE_TIMEOUT_SECONDS=30
# Memory: 刷写节流间隔(分钟) / 整合最大 token / 整合最小间隔(分钟)
# AGENT_MEMORY_FLUSH_THROTTLE_MINUTES=10
# AGENT_MEMORY_CONSOLIDATION_MAX_TOKENS=8000
# AGENT_MEMORY_CONSOLIDATION_MIN_GAP_MINUTES=60
# 记忆总开关: false = 完全关闭记忆（不注册 memory_* 工具 + 不执行 flush/整合, 沙箱不再注入/回写记忆文件）
# AGENT_MEMORY_ENABLED=true
# Compaction: 触发压缩消息数 / token 阈值 / 动态模式的预留窗口 / 压缩后保留消息数 / 压缩前刷写记忆 / 压缩前卸载大工具结果
# AGENT_COMPACTION_TRIGGER_MESSAGES=30
# AGENT_COMPACTION_TRIGGER_TOKENS=80000
# AGENT_COMPACTION_RESERVED_TOKENS=20000
# AGENT_COMPACTION_KEEP_MESSAGES=10
# AGENT_COMPACTION_FLUSH_BEFORE_COMPACT=true
# AGENT_COMPACTION_OFFLOAD_BEFORE_COMPACT=true
# HikariCP 连接池: 最大连接数 / 最小空闲 / 连接超时(ms) / 空闲超时(ms) / 最大生命周期(ms)
# AGENT_DB_POOL_MAX_SIZE=10
# AGENT_DB_POOL_MIN_IDLE=2
# AGENT_DB_POOL_CONNECTION_TIMEOUT_MS=30000
# AGENT_DB_POOL_IDLE_TIMEOUT_MS=600000
# AGENT_DB_POOL_MAX_LIFETIME_MS=1800000
