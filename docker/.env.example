# =============================================================================
# Agent Manager — Docker Compose 环境变量模板
# =============================================================================
# 使用方法: cp .env.example .env 并修改其中的值
# 敏感配置 (LLM API Key 等) 另存为 .env.secrets，通过 docker compose --env-file 引入
# =============================================================================

# -------------------------------- 容器通用配置 ------------------------------------
RESTART_POLICY=unless-stopped              # 重启策略: no | always | on-failure | unless-stopped

# -------------------------------- Nginx 反向代理 --------------------------------
NGINX_IMAGE=nginx:alpine                   # Nginx 镜像
NGINX_PORT=8911                            # Nginx 对外端口

# -------------------------------- MySQL (GreatSQL) ------------------------------
MYSQL_IMAGE=greatsql/greatsql:8.0.32-25    # GreatSQL 镜像
MYSQL_ROOT_PASSWORD=root123                # MySQL root 密码
MYSQL_DATABASE=agent_manager               # 默认数据库名
MYSQL_USER=agent_manager                   # 应用数据库用户
MYSQL_PASSWORD=Agent@Manager2026           # 应用数据库密码
MYSQL_HOST_PORT=3307                       # 宿主机端口映射 (GreatSQL 内部端口 3306)

# -------------------------------- MinIO 对象存储 ---------------------------------
MINIO_IMAGE=minio/minio:latest             # MinIO 镜像
MINIO_ROOT_USER=minioadmin                 # MinIO root 用户名
MINIO_ROOT_PASSWORD=minioadmin             # MinIO root 密码
MINIO_API_HOST_PORT=9000                   # MinIO API 宿主机端口
MINIO_CONSOLE_HOST_PORT=9001               # MinIO Console 宿主机端口

# -------------------------------- 前端 (Next.js) ---------------------------------
# NODE_ENV=production                      # 前端运行模式 (production/development)

# -------------------------------- 后端 (Go/Gin) ----------------------------------

# --- 服务基础 ---
SERVER_PORT=8080                           # 后端监听端口 (容器内部)

# --- 数据库连接 ---
# DSN 中的 host 在 Docker Compose 网络中使用服务名 "mysql":3306
# 非 Docker 环境使用 127.0.0.1:3307
MYSQL_DSN=${MYSQL_USER}:${MYSQL_PASSWORD}@tcp(mysql:3306)/${MYSQL_DATABASE}?charset=utf8mb4&parseTime=True&loc=Local

# --- MinIO 连接 ---
MINIO_ENDPOINT=minio:9000                  # MinIO 地址 (容器内用服务名)
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}        # MinIO 访问密钥
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}    # MinIO 密钥
MINIO_BUCKET=agent-manager                 # MinIO Bucket 名称

# --- Kubernetes ---
KUBE_CONFIG=                               # kubeconfig 路径 (空=默认 ~/.kube/config，容器内需挂载)
KUBE_NAMESPACE=default                     # K8s 命名空间
KUBE_INGRESS_CLASS=nginx                   # Ingress Controller 类型
K8S_CLIENT_MODE=kubectl                    # K8s 客户端模式: kubectl (CLI, 默认) | api (client-go SDK)
# K8S_CLIENT_MODE=api 启用方式:
#   1. go get k8s.io/client-go@latest && go mod tidy   # 下载 client-go 依赖
#   2. go build -tags api ./cmd/server                  # 构建时加 -tags api
#   3. export K8S_CLIENT_MODE=api                       # 运行时设置环境变量

# --- Docker Registry ---
LOCAL_REGISTRY=172.20.0.1:5001             # 本地 Docker Registry 地址 (宿主机 IP)
DOCKER_USERNAME=                           # Registry 用户名 (可选)
DOCKER_PASSWORD=                           # Registry 密码 (可选)

# --- 代码生成 ---
CODEGEN_PYTHON=/opt/codegen-venv/bin/python3   # Python 解释器路径 (容器内)
CODEGEN_SCRIPT=/opt/codegen/generator.py       # 代码生成脚本路径 (容器内)

# --- Agent 部署 ---
INGRESS_HOST=localhost                     # Ingress 对外地址 (生产环境需设为 nginx 入口地址)
INGRESS_ENABLED=true                       # 是否启用 Ingress
DEPLOY_METHOD=sandbox                      # Agent 部署方式: sandbox (CRD, 默认) | deployment (标准 Deployment)
# sandbox 模式: 使用 agents.x-k8s.io/v1alpha1 Sandbox CRD 管理 Agent Pod
# deployment 模式: 使用标准 K8s Deployment + TemplateEngine 模板渲染 YAML，支持 ConfigMap/Secret 卷挂载
DEPLOY_TEMPLATE_DIR=                       # deployment 模式自定义模板目录 (.yaml.tmpl 文件)，空=使用内置模板

# --- 基础镜像 ---
BASE_IMAGE_NAME=agent-base:latest          # 基础镜像名称
BUILD_BASE_IMAGE=false                     # 启动时自动构建基础镜像
# BUILD_BASE_IMAGE=true 的前提条件 (Docker Compose 环境下需满足):
#   1. 后端容器需挂载 Docker Socket: volumes: ["/var/run/docker.sock:/var/run/docker.sock"]
#   2. DOCKER_USERNAME / DOCKER_PASSWORD 必须非空 (本地 Registry 可留空则跳过登录)
#   3. Dockerfile.base 中 pip install 需能访问外网
#   不满足上述条件时设置 BUILD_BASE_IMAGE=false，使用已缓存的 agent-base 镜像

# --- Agent 挂载模式镜像 ---
# 格式: 镜像名|显示名称，多个用 | 分隔，首个为默认值
AVAILABLE_IMAGES=agent-framework:latest|Agent Framework v0.5.5
DEFAULT_IMAGE=agent-framework:latest

# --- Checkpoint 数据库 ---
# K8s Pod 内连接宿主机须用 Docker 网关 IP (172.20.0.1)，不可用 127.0.0.1
DEFAULT_CHECKPOINT_DSN=

# =============================================================================
# 以下变量为敏感信息，建议通过 .env.secrets 文件提供 (不提交到 Git)
# =============================================================================

# --- LLM 配置 (必填) ---
# LLM_API_KEY=sk-your-api-key              # LLM API 密钥，注入到 Pod 为 LLM_API_KEY (Secret)
# LLM_MODEL=qwen3.6-plus                   # 模型名称，注入到 Pod 为 LLM_MODEL_ID
# LLM_ENDPOINT=https://api.example.com/v1  # API 端点，注入到 Pod 为 LLM_BASE_URL
# 注意: LLM_PROVIDER 在 sandbox 模板中硬编码为 "ctyun" (backend/internal/k8s/sandbox.go:80,350)
#       不可通过环境变量修改，前端/后端均不读取此变量
