# Agent Manager .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
codegen/venv/
codegen/test/output/

# Go
backend/vendor/
*.exe
*.dll
*.so
*.dylib
backend/bin/

# Java
target/
*.class
*.jar
*.war

# Node
node_modules/
backend/server

# Node
node_modules/
e2e/node_modules/
**/node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
*.tar

# Environment
.env
.env.local
.env.*.local
.env.test
.env.secrets

# Logs
*.log

# Kind / K8s
sandbox/manifest.yaml
sandbox/extensions.yaml
docs/kind-config.yaml

# Temp
tmp/
temp/
*.tmp

# Secrets (keep API keys out of repo)
!codegen/schema/agent_config.json

# Screenshots
e2e/screenshots/
*.png

# E2E test scripts
e2e/screenshot.js
e2e/hitl-card-test.js
e2e/screenshot-hitl.js
e2e/screenshot-ui.js
e2e/screenshot-verify.js
e2e/send_email.py

# Approval Demo: 构建产物 / 依赖 / 截图（不纳入仓库）
*.tar.gz
agent-framework/example/approval-forms/e2e/node_modules/
agent-framework/example/approval-forms/e2e/screenshots/
agent-framework/example/approval-forms/e2e/screenshots-full/
